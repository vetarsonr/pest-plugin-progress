{
    "name": "vetarsonr/pest-plugin-progress",
    "description": "Compact progress output for large Pest test suites, with failure summaries and plain-text reports for debugging.",
    "keywords": [
        "php",
        "framework",
        "pest",
        "unit",
        "test",
        "testing",
        "plugin"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "vetarsonr",
            "homepage": "https://github.com/vetarsonr"
        }
    ],
    "require": {
        "php": "^8.1",
        "pestphp/pest": "^2.0 || ^3.0 || ^4.0 || ^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Vendor\\PestProgress\\": "src/"
        }
    },
    "extra": {
        "pest": {
            "plugins": ["Vendor\\PestProgress\\Plugin"]
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "refacto": "rector",
        "lint": "pint",
        "test:refacto": "rector --dry-run",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "@php vendor/bin/pest",
        "test": "@test:unit"
    }
}
